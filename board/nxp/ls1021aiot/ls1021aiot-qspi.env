/*
 * QSPI boot: two OS slots, each an OpenWrt FIT with a kernel, a device
 * tree and a squashfs. os1 is on the first die of the S70FL01GS, after
 * U-Boot and its environment, os2 on the second die.
 *
 * U-Boot reads the whole FIT and bootm checks the hashes of the kernel, the
 * device tree and the squashfs; a FIT that fails returns here and the other
 * slot is tried. The squashfs is the ramdisk: Linux runs it from RAM.
 *
 * The CPLD scratch register 0x1C counts the boots that did not reach
 * Linux: U-Boot adds one before each boot and Linux clears it once it is
 * up. It keeps its value across resets and clears only when the CPLD is
 * reset (power cycle or cold reboot). After os_tries boots that did not
 * come up, U-Boot makes the other slot the active one.
 */

console=ttyS0,115200
initrd_high=0xffffffff
os_slot=1
os_tries=3
os_load=0x88000000
os1_size=0x2000000
os2_size=0x2000000
/*
 * The CPLD registers answer at their own addresses only when IFC CS0 runs
 * in NOR ADM AVD mode with a long address phase, as the ls1021aiot-cpld
 * driver of Linux sets it, and once 0x3C is written at 0xC3. IFC registers
 * are big-endian, so mw.l takes each value byte-swapped: CSPR0 0x7fb00080
 * (NOR, invalid), CSOR0 0x80000020, FTIM0-2 0x10200410 0xff003f3f
 * 0x0f3c40ff, CSPR0 0x7fb00081 (valid).
 */
cpld_unlock=mw.l 0x1530010 0x8000b07f; mw.l 0x1530130 0x20000080;
	mw.l 0x15301c0 0x10042010; mw.l 0x15301c4 0x3f3f00ff;
	mw.l 0x15301c8 0xff403c0f; mw.l 0x1530010 0x8100b07f;
	mw.b 0x7fb000c3 0x3c
os_set1=setenv sfdev 0:0; setenv sfoff 0x200000; setenv sfsize ${os1_size}
os_set2=setenv sfdev 0:1; setenv sfoff 0x0; setenv sfsize ${os2_size}
os_try=run os_set${s}; echo Booting os${s};
	sf probe ${sfdev} && sf read ${os_load} ${sfoff} ${sfsize} &&
	setenv bootargs console=${console} root=/dev/ram0 os_slot=${s} &&
	bootm ${os_load}; echo os${s} does not boot
os_other=if test ${s} = 1; then setenv s 2; else setenv s 1; fi
os_boot=run cpld_unlock; setexpr.b n *0x7fb0001c; setexpr n ${n} + 1;
	mw.b 0x7fb0001c ${n};
	if test ${n} -gt ${os_tries}; then
		echo os${os_slot} did not come up ${os_tries} times;
		setenv s ${os_slot}; run os_other; setenv os_slot ${s};
		saveenv; mw.b 0x7fb0001c 1;
	fi;
	setenv s ${os_slot}; run os_try; run os_other; run os_try;
	echo No OS slot boots
bootcmd=run os_boot
